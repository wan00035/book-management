@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="text-center mb-4 fw-bold">Create an Account</h2>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center">
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div class="form-group mb-3">
                        <label class="control-label fw-bold mb-1">Username</label>
                        <input type="text" name="username" class="form-control" placeholder="Choose a username" required />
                    </div>
                    <div class="form-group mb-4">
                        <label class="control-label fw-bold mb-1">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="Create a password" required />
                    </div>
                    <div class="form-group d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-block fw-bold">Sign Up</button>
                    </div>
                </form>
                
                <div class="text-center mt-3">
                    <span class="text-muted">Already have an account?</span>
                    <a asp-action="Login" class="text-decoration-none fw-bold">Log in here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}