@model List<Book>

@{
    ViewData["Title"] = "Books Overview";
}

<h1>Books Overview</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success fw-bold text-center mt-3">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger fw-bold text-center mt-3">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row mt-3">
    <div class="col-md-4">
        @if (ViewBag.Role == "Admin")
        {
            <a asp-action="New" class="btn btn-primary mb-3">Add a New Book</a>
        }
    </div>
</div>

<table class="table table-hover table-bordered align-middle text-center">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Publication Year</th>
            <th>Status</th>
            <th>Actions</th> </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.PublicationYear.ToString("yyyy")</td>
                
                <td>
                    @if (item.IsCheckedOut)
                    {
                        <span class="badge bg-danger">Checked Out</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Available</span>
                    }
                </td>
                
                <td>
                    @if (!item.IsCheckedOut)
                    {
                        <a asp-action="Borrow" asp-route-id="@item.BookID" class="btn btn-sm btn-success">Borrow</a>
                    }
                    else
                    {
                        <a asp-action="Return" asp-route-id="@item.BookID" class="btn btn-sm btn-warning">Return</a>
                    }

                    @if (ViewBag.Role == "Admin")
                    {
                        <span class="mx-2">|</span>
                        <a asp-action="Edit" asp-route-id="@item.BookID" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.BookID" data-name="@item.Title" class="delete btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {
            // Confirmation dialog for the delete action
            $('.delete').on('click', function (e) {
                e.preventDefault();
                var link = $(this).attr('href');
                var bookName = $(this).data('name');

                if (confirm('Are you sure you want to delete the book: "' + bookName + '"?')) {
                    window.location.href = link;
                }
            });
        });
    </script>
}