@model List<Book>

@{
    ViewData["Title"] = "Books Overview";
}

<h1>Books Overview</h1>
<a href="@Url.Action("Index", "Upload")">Go to Upload Page</a>

<div class="row mt-3">
    <div class="col-md-4">
        @if (ViewBag.Role == "Admin")
        {
            <a asp-action="New" class="btn btn-primary">Add a New Book</a>
        }
    </div>
    <div class="col-md-8">
        <span class="alert-info">@ViewBag.Confirmation</span>
    </div>
</div>
<br />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Publication Year</th>
            <th>Is Checked Out</th>
            
            @if (ViewBag.Role == "Admin")
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.PublicationYear.ToString("yyyy")</td>
                <td>@(item.IsCheckedOut ? "Yes" : "No")</td>
                
                @if (ViewBag.Role == "Admin")
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.BookID">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.BookID" data-name="@item.Title" class="delete text-danger">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {
            // Confirmation dialog for the delete action
            $('.delete').on('click', function (e) {
                e.preventDefault();
                var link = $(this).attr('href');
                var bookName = $(this).data('name');

                if (confirm('Are you sure you want to delete this book: ' + bookName + '?')) {
                    window.location.href = link;
                }
            });
        });
    </script>
}